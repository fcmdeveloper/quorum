{
  "expo": {
    "name": "Quorum",
    "slug": "quorum",
    "scheme": "quorum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "cl.minify.quorum",
      "supportsTablet": false,
      "infoPlist": {
        "NFCReaderUsageDescription": "Quorum usa NFC para firmar con tus tarjetas Tangem.",
        "NSBluetoothAlwaysUsageDescription": "Quorum usa Bluetooth para firmar con tu Ledger.",
        "NSBluetoothPeripheralUsageDescription": "Quorum usa Bluetooth para firmar con tu Ledger.",
        "com.apple.developer.nfc.readersession.iso7816.select-identifiers": [
          "A000000812010208",
          "D2760000850101"
        ],
        "LSApplicationQueriesSchemes": [
          "xumm",
          "xaman"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "cl.minify.quorum",
      "permissions": [
        "android.permission.NFC",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Quorum usa Bluetooth para firmar con tu Ledger."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "extraPods": [
              {
                "name": "TangemSdk",
                "git": "https://github.com/tangem/tangem-sdk-ios.git",
                "tag": "5.2.5"
              },
              {
                "name": "CryptoSwift",
                "git": "https://github.com/krzyzanowskim/CryptoSwift.git",
                "tag": "1.9.0"
              }
            ]
          },
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://jitpack.io"
            ]
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Quorum usa la cámara para leer códigos QR de direcciones y operaciones.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Quorum usa Face ID para proteger el acceso a la app."
        }
      ],
      "./plugins/withSceneLifecycle"
    ]
  }
}