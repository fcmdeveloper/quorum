{
  "expo": {
    "name": "Quorum",
    "slug": "quorum",
    "scheme": "quorum",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "cl.minify.quorum",
      "supportsTablet": false,
      "infoPlist": {
        "NFCReaderUsageDescription": "Quorum usa NFC para firmar con tus tarjetas Tangem.",
        "NSBluetoothAlwaysUsageDescription": "Quorum usa Bluetooth para firmar con tu Ledger.",
        "NSBluetoothPeripheralUsageDescription": "Quorum usa Bluetooth para firmar con tu Ledger.",
        "com.apple.developer.nfc.readersession.iso7816.select-identifiers": [
          "A000000812010208",
          "D2760000850101"
        ],
        "LSApplicationQueriesSchemes": [
          "xumm",
          "xaman"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:quorumxrpl.com"
      ],
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "cl.minify.quorum",
      "permissions": [
        "android.permission.NFC",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Quorum usa Bluetooth para firmar con tu Ledger."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "extraPods": [
              {
                "name": "TangemSdk",
                "git": "https://github.com/tangem/tangem-sdk-ios.git",
                "tag": "5.2.5"
              },
              {
                "name": "CryptoSwift",
                "git": "https://github.com/krzyzanowskim/CryptoSwift.git",
                "tag": "1.9.0"
              }
            ]
          },
          "android": {
            "minSdkVersion": 26,
            "extraMavenRepos": [
              "https://jitpack.io"
            ]
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Quorum usa la cámara para leer códigos QR de direcciones y operaciones.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Quorum usa Face ID para proteger el acceso a la app."
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withReproducibleHermes",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Light",
            "ios": "./assets/icons/light.png",
            "android": {
              "foregroundImage": "./assets/icons/light.png",
              "backgroundColor": "#EEF3EF"
            }
          },
          {
            "name": "Gallery",
            "ios": "./assets/icons/gallery.png",
            "android": {
              "foregroundImage": "./assets/icons/gallery.png",
              "backgroundColor": "#051a1c"
            }
          },
          {
            "name": "Ember",
            "ios": "./assets/icons/ember.png",
            "android": {
              "foregroundImage": "./assets/icons/ember.png",
              "backgroundColor": "#1a0806"
            }
          },
          {
            "name": "Ocean",
            "ios": "./assets/icons/ocean.png",
            "android": {
              "foregroundImage": "./assets/icons/ocean.png",
              "backgroundColor": "#04101f"
            }
          },
          {
            "name": "Violet",
            "ios": "./assets/icons/violet.png",
            "android": {
              "foregroundImage": "./assets/icons/violet.png",
              "backgroundColor": "#120a22"
            }
          },
          {
            "name": "Solar",
            "ios": "./assets/icons/solar.png",
            "android": {
              "foregroundImage": "./assets/icons/solar.png",
              "backgroundColor": "#151204"
            }
          },
          {
            "name": "Rose",
            "ios": "./assets/icons/rose.png",
            "android": {
              "foregroundImage": "./assets/icons/rose.png",
              "backgroundColor": "#1c0610"
            }
          },
          {
            "name": "Ice",
            "ios": "./assets/icons/ice.png",
            "android": {
              "foregroundImage": "./assets/icons/ice.png",
              "backgroundColor": "#0c1218"
            }
          },
          {
            "name": "XrpMidnight",
            "ios": "./assets/icons/xrp-midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-midnight.png",
              "backgroundColor": "#05070d"
            }
          },
          {
            "name": "XrpAurora",
            "ios": "./assets/icons/xrp-aurora.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-aurora.png",
              "backgroundColor": "#06121a"
            }
          },
          {
            "name": "XrpSunset",
            "ios": "./assets/icons/xrp-sunset.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-sunset.png",
              "backgroundColor": "#1a0816"
            }
          },
          {
            "name": "XrpGold",
            "ios": "./assets/icons/xrp-gold.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-gold.png",
              "backgroundColor": "#120c04"
            }
          },
          {
            "name": "XrpElectric",
            "ios": "./assets/icons/xrp-electric.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-electric.png",
              "backgroundColor": "#040624"
            }
          },
          {
            "name": "XrpCrimson",
            "ios": "./assets/icons/xrp-crimson.png",
            "android": {
              "foregroundImage": "./assets/icons/xrp-crimson.png",
              "backgroundColor": "#160406"
            }
          }
        ]
      ]
    ]
  }
}
